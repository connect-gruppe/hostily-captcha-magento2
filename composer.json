{
  "name": "hostily/module-captcha",
  "description": "hostily Captcha as a CAPTCHA type for Magento 2 (storefront forms and checkout)",
  "type": "magento2-module",
  "license": "MIT",
  "version": "0.1.2",
  "require": {
    "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
    "magento/framework": "^103.0.7",
    "magento/module-store": "^101.1.7",
    "magento/module-config": "^101.2.7",
    "magento/module-csp": "^100.4.6",
    "magento/module-re-captcha-ui": "^1.1",
    "magento/module-re-captcha-admin-ui": "^1.1",
    "magento/module-re-captcha-frontend-ui": "^1.1",
    "magento/module-re-captcha-validation-api": "^1.1"
  },
  "suggest": {
